{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "electron",
    "outDir": "electron-dist",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["electron/**/*.ts"],
  // preload.ts is bundled separately into CommonJS (electron-dist/preload.cjs):
  // Electron loads a sandboxed preload as CJS and cannot resolve relative
  // requires, so the ESM output tsc would emit here is unloadable.
  "exclude": ["electron/**/*.test.ts", "electron/preload.ts"]
}
