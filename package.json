{
  "name": "biostat-studio",
  "version": "0.1.0",
  "description": "Offline-first bilingual biostatistics workflow and Word reporting application for Apple Silicon macOS.",
  "author": "grogureis",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test": "bash scripts/test-all.sh",
    "test:python": "services/analysis/.venv-py312/bin/python -m pytest services/analysis/tests",
    "test:desktop": "npm run test --workspace apps/desktop",
    "dev": "npm run dev --workspace apps/desktop",
    "package:mac": "bash scripts/package-macos.sh"
  }
}
